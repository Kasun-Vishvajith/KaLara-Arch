# IDE / Editor configuration
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosv
*.sln.docstates

# Python virtual environments & cache
tools/python/.venv/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Secrets & Environment variables
.env
*.key
*.pem

# OS generated files
Thumbs.db
Desktop.ini
.DS_Store
